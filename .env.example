# ==========================================
# V1100 (MF Local Engine) 絕對私有化配置
# ==========================================

# 🧠 1. 本地大腦配置 (指向本地 Ollama)
# 這裡的 Key 可以隨便填，因為本地 Ollama 不需要驗證
LLM_API_KEY=local-ollama-nuke-key
# 指向您本地電腦的 Ollama 服務埠
LLM_BASE_URL=http://localhost:11434/v1
# 確保您已經在終端機跑過 `ollama run qwen2.5:7b`
LLM_MODEL_NAME=qwen2.5:7b

# 🗑️ 2. ZEP 記憶圖譜配置 (已廢棄)
# 我們已經物理切除 Zep，請保持空白或註解掉！
# ZEP_API_KEY=

# ⚡ 3. 加速 LLM 配置 (已廢棄)
# 本地環境不需要 Boost，強烈建議不要出現這三行，以免系統誤判。

# 💾 4. 本地 Neo4j 記憶庫配置
NEO4J_URI=bolt://localhost:7687
# 【⚠️ 首席 CTO 的安全確認】
# 首長，本地 Neo4j Desktop 的預設使用者名稱通常是 "neo4j"。
# 除非您有特別去更改系統底層設定，否則請用 "neo4j"。
NEO4J_USERNAME=neo4j
# 填入您建立資料庫時設定的密碼
NEO4J_PASSWORD=zueNykQDuq6IdEd0HPfDYhaaXmJzRqKYeyHtAiTcIOw